# =======================
# Django server settings
# =======================
# Shared secret used by local print agents (required)
PRINT_AGENT_TOKEN=change-me

# Max retries before a print job becomes FAILED (default 3)
PRINT_JOB_MAX_ATTEMPTS=3


# =======================
# Print agent settings
# =======================
# Example:
# SERVER_BASE_URL=http://192.168.1.10:8000
SERVER_BASE_URL=http://127.0.0.1:8000
DEVICE_ID=cashier-1
PRINT_AGENT_TOKEN=change-me

PRINTER_BACKEND=usb
PRINTER_PROFILE=TM-T88III
PRINTER_USB_VENDOR_ID=0x0000
PRINTER_USB_PRODUCT_ID=0x0000
PRINTER_USB_INTERFACE=0
# Optional endpoints (only if your device needs it)
# PRINTER_USB_OUT_EP=0x01
# PRINTER_USB_IN_EP=0x82
PRINTER_PRINT_DELAY_SECONDS=0.7

# Optional logo
# RECEIPT_LOGO_PATH=C:\path\to\logo.png
# RECEIPT_LOGO_WIDTH=384
# RECEIPT_LOGO_IMPL=bitImageColumn

